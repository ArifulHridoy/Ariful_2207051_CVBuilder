<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="700" prefWidth="1000" style="-fx-background-color: #f8f9fa; -fx-font-family: 'Montserrat';" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.sheikh_2207051_cvbuilder.controllers.HomeController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-background-color: linear-gradient(to bottom right, rgba(0,0,0,0.7), rgba(0,0,0,0.7)); -fx-padding: 16; -fx-border-color: #e0e0e0; -fx-border-width: 0 0 1 0;">
            <Label alignment="CENTER" prefHeight="35.0" prefWidth="890.0" style="-fx-text-fill: rgb(255,255,255); -fx-font-size: 26px; -fx-font-weight: 800;" text="✍ CV Builder" />
            <Region HBox.hgrow="ALWAYS" />
            <Label style="-fx-text-fill: #ffffff; -fx-font-size: 14px;" text="👤 Ariful" />
        </HBox>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="12" style="-fx-padding: 20;">
            <HBox spacing="10" alignment="CENTER_RIGHT" style="-fx-padding: 0 0 10 0;">
                <Button onAction="#onCreateNewCV" style="-fx-background-color: #4a90e2; -fx-text-fill: white; -fx-font-weight: bold;" text="New CV" />
                <Button onAction="#onRefresh" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold;" text="Refresh" />
            </HBox>
            <ListView fx:id="cvListView" prefWidth="800" prefHeight="480" />
            <Label style="-fx-text-fill: #6b6b6b; -fx-font-size: 13px;" text="Double-click an item to preview/edit." />
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT" style="-fx-background-color: linear-gradient(to top right, rgba(0,0,0,0.7), rgba(0,0,0,0.7)); -fx-padding: 12 16; -fx-border-color: #e5e5e5; -fx-border-width: 1 0 0 0;">
            <Label style="-fx-text-fill: #9b9b9b; -fx-font-size: 11px;" text="© 2025 Ariful — All Rights Reserved" />
        </HBox>
    </bottom>
</BorderPane>
