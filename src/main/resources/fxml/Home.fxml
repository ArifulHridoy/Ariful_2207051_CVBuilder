<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane minHeight="500" minWidth="700" prefHeight="650" prefWidth="900" style="-fx-background-color: #000000; -fx-font-family: 'Roboto Regular';" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.sheikh_2207051_cvbuilder.controllers.HomeController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-background-color: #ffffff; -fx-padding: 12;">
            <Label alignment="CENTER" prefHeight="36.0" prefWidth="864.0" style="-fx-text-fill: #000000; -fx-font-size: 28px; -fx-font-weight: bold; -fx-font-family: 'Montserrat Bold';" text="CV Builder APK" />
        </HBox>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="20" style="-fx-background-color: #000000; -fx-background-radius: 10; -fx-padding: 30;                      -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 8, 0, 0, 2);" BorderPane.alignment="CENTER">
            <Label style="-fx-text-fill: #a2c7ff; -fx-font-size: 16px; -fx-font-weight: bold;" text="Welcome to the CV Builder" wrapText="true" />
            <Label style="-fx-text-fill: #9d93ff; -fx-font-size: 12px; -fx-font-weight: bold;                           -fx-text-alignment: center;" text="Create your professional-looking CV here. Click below to start." wrapText="true" />
            <Button onAction="#onCreateNewCV" prefHeight="45" prefWidth="250" style="-fx-background-color: #0046cc; -fx-text-fill: #ffffff;                            -fx-font-size: 13px; -fx-font-weight: bold;                            -fx-background-radius: 5; -fx-padding: 8 20;                            -fx-cursor: hand;" text="Create Your CV" />
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT" prefHeight="50.0" prefWidth="900.0" style="-fx-background-color: #ffffff; -fx-padding: 10 15;">
            <Label style="-fx-text-fill: #5d7fa6; -fx-font-size: 12px;" text="© 2025 All Rights Reserved by Ariful" />
        </HBox>
    </bottom>

</BorderPane>
