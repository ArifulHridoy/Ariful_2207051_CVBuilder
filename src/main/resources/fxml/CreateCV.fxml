<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane style="-fx-background-color: #9f9ffa;" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/17.0.12" fx:controller="com.example.sheikh_2207051_cvbuilder.controllers.CreateController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-background-color: #2c3e50; -fx-padding: 10;">
            <Label alignment="CENTER" prefHeight="30.0" prefWidth="874.0" style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;" text="Please fill up the form below with proper information for your CV :" />
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
            <VBox prefWidth="900" spacing="12" style="-fx-background-color: #ffffff; -fx-padding: 20; -fx-border-color: #dcdcdc; -fx-border-width: 1; -fx-border-radius: 5; -fx-background-radius: 5;">

                <GridPane hgap="10" vgap="10">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="25"/>
                        <ColumnConstraints percentWidth="75"/>
                    </columnConstraints>

                    <Label style="-fx-font-weight:bold;" text="Full Name:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <TextField fx:id="fullNameField" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                    <Label style="-fx-font-weight:bold;" text="Email:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                    <TextField fx:id="emailField" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                    <Label style="-fx-font-weight:bold;" text="Phone:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                    <TextField fx:id="phoneField" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                    <Label style="-fx-font-weight:bold;" text="Address:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                    <TextField fx:id="addressField" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                    <Label style="-fx-font-weight:bold;" text="Education (one per line):" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                    <TextArea fx:id="educationArea" prefRowCount="4" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="4"/>

                    <Label style="-fx-font-weight: bold;" text="Skills (comma/line separated):" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
                    <TextArea fx:id="skillsArea" prefRowCount="3" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="5"/>

                    <Label style="-fx-font-weight: bold;" text="Work Experience:" GridPane.columnIndex="0" GridPane.rowIndex="6"/>
                    <TextArea fx:id="experienceArea" prefRowCount="4" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="6"/>

                    <Label style="-fx-font-weight: bold;" text="Projects:" GridPane.columnIndex="0" GridPane.rowIndex="7"/>
                    <TextArea fx:id="projectsArea" prefRowCount="4" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="7"/>

                    <Label style="-fx-font-weight: bold;" text="Profile Photo :" GridPane.columnIndex="0" GridPane.rowIndex="8"/>
                    <HBox spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="8">
                        <ImageView fx:id="photoView" fitHeight="80" fitWidth="80" preserveRatio="true" />
                        <Button onAction="#onUploadPhoto" style="-fx-background-color: #007cca; -fx-text-fill: white; -fx-font-weight: bold;" text="Upload"/>
                        <Button onAction="#onRemovePhoto" style="-fx-background-color: #ff1900; -fx-text-fill: white; -fx-font-weight: bold;" text="Remove"/>
                    </HBox>
               <rowConstraints>
                  <RowConstraints/>
                  <RowConstraints/>
                  <RowConstraints/>
                  <RowConstraints/>
                  <RowConstraints/>
                  <RowConstraints/>
                  <RowConstraints/>
                  <RowConstraints/>
                  <RowConstraints/>
               </rowConstraints>
                </GridPane>

                <Separator/>

                <HBox alignment="CENTER_RIGHT" spacing="10" style="-fx-padding: 10 0 0 0;">
                    <Button onAction="#onBack" style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-weight: bold;" text="Back"/>
                    <Button onAction="#onGenerateCV" style="-fx-background-color: #19b336; -fx-text-fill: white; -fx-font-weight: bold;" text="Generate CV"/>
                </HBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
