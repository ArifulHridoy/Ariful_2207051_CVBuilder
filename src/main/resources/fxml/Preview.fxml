<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane style="-fx-background-color: #f4f4f9;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.sheikh_2207051_cvbuilder.controllers.PreviewController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-background-color: #2c3e50; -fx-padding: 10;">
            <Label alignment="CENTER" prefHeight="30.0" prefWidth="794.0" style="-fx-text-fill: white;
            -fx-font-size: 22px; -fx-font-weight: bold;" text="CV Preview" />
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; ">
            <VBox prefWidth="820" spacing="12" style="-fx-background-color: linear-gradient(to bottom right, #ffffff, #929dbd);
            -fx-padding: 20; -fx-border-color: #dcdcdc; -fx-border-width: 1; -fx-border-radius: 5; -fx-background-radius: 5;">

                <HBox alignment="TOP_LEFT" spacing="20">
                    <VBox spacing="5">
                        <Label fx:id="nameLabel" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #34495e;"/>
                        <Label fx:id="contactLabel" style=" -fx-text-fill: #555555; -fx-font-size: 13px"/>
                        <Label fx:id="addressLabel" style=" -fx-text-fill: #555555; -fx-font-size: 13px" wrapText="true"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS" />
                    <ImageView fx:id="photoPreview" fitHeight="120" fitWidth="120" preserveRatio="true" />
                </HBox>

                <Separator />

                <VBox spacing="8">
                    <Label style="-fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-font-size: 17px" text="Education :" textFill="#fffefe" />
                    <Label fx:id="educationLabel" style="-fx-text-fill: #000000; -fx-font-size: 15px" wrapText="true" />
                </VBox>

                <VBox spacing="8">
                    <Label style="-fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-font-size: 17px" text="Skills :" />
                    <Label fx:id="skillsLabel" style="-fx-text-fill: #000000; -fx-font-size: 15px" wrapText="true" />
                </VBox>

                <VBox spacing="8">
                    <Label style="-fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-font-size: 17px" text="Work Experience :" />
                    <Label fx:id="experienceLabel" style="-fx-text-fill: #000000; -fx-font-size: 15px" wrapText="true" />
                </VBox>

                <VBox spacing="8">
                    <Label style="-fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-font-size: 17px" text="Projects :" />
                    <Label fx:id="projectsLabel" style="-fx-text-fill: #000000; -fx-font-size: 15px" wrapText="true" />
                </VBox>

                <HBox alignment="CENTER_RIGHT" spacing="10" style="-fx-padding: 10 0 0 0;">
                    <Button onAction="#onEdit" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold;" text="Edit" />
                    <Button onAction="#onBackHome" style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-weight: bold;" text="Back Home" />
                </HBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
