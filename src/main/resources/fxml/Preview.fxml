<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.sheikh_2207051_cvbuilder.controllers.PreviewController"
            style="-fx-background-color: #f4f4f9;">

    <top>
        <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-background-color: #2c3e50; -fx-padding: 10;">                     <Label text="CV Preview" style="-fx-text-fill: white;
                             -fx-font-size: 20px;                                           -fx-font-weight: bold;" />
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
            <VBox spacing="12" prefWidth="820" style="-fx-background-color: #ffffff;                      -fx-padding: 20; -fx-border-color: #dcdcdc;                      -fx-border-width: 1;                      -fx-border-radius: 5;                      -fx-background-radius: 5;">

                <HBox spacing="20" alignment="TOP_LEFT">
                    <VBox spacing="5">
                        <Label fx:id="nameLabel" style="-fx-font-size: 18px;                                           -fx-font-weight: bold;                      -fx-text-fill: #34495e;" />
                        <Label fx:id="contactLabel" style="                     -fx-text-fill: #555555;" />
                        <Label fx:id="addressLabel" wrapText="true" style="                                          -fx-text-fill: #555555;" />
                    </VBox>
                    <Region HBox.hgrow="ALWAYS" />
                    <ImageView fx:id="photoPreview" fitHeight="120" fitWidth="120" preserveRatio="true"/>
                </HBox>

                <Separator />

                <VBox spacing="8">
                    <Label text="Education" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
                    <Label fx:id="educationLabel" wrapText="true" style="-fx-text-fill: #555555;" />
                </VBox>

                <VBox spacing="8">
                    <Label text="Skills" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
                    <Label fx:id="skillsLabel" wrapText="true" style="-fx-text-fill: #555555;" />
                </VBox>

                <VBox spacing="8">
                    <Label text="Work Experience" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
                    <Label fx:id="experienceLabel" wrapText="true" style="-fx-text-fill: #555555;" />
                </VBox>

                <VBox spacing="8">
                    <Label text="Projects" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
                    <Label fx:id="projectsLabel" wrapText="true" style="-fx-text-fill: #555555;" />
                </VBox>

                <HBox spacing="10" alignment="CENTER_RIGHT" style="-fx-padding: 10 0 0 0;">
                    <Button text="Edit" onAction="#onEdit" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold;" />
                    <Button text="Back Home" onAction="#onBackHome" style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-weight: bold;" />
                </HBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
